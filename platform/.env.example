# MASLD-Bench Platform configuration.
# Copy to platform/.env and fill in values. NEVER commit the real .env.

# --- Core paths -------------------------------------------------------------
# Root of the research repo (contains prompts/, results/, checkpoints/).
# Defaults to the parent of this platform/ directory.
MASLD_ROOT=

# Data directory for platform state (sqlite db, run logs, snapshots).
# Defaults to platform/data.
MASLD_DATA_DIR=

# Database URL. Default: sqlite:///<data>/masld.db
# Docker/Postgres example: postgresql+psycopg://masld:masld@postgres:5432/masld
MASLD_DB_URL=

# Reproducibility seed for sampling / bootstrap (matches the research freeze).
MASLD_SEED=20260929

# --- Credentials (env only; no file fallbacks, never logged) -----------------
# Required for frontier runs. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: gated HuggingFace models. Qwen public weights need no token.
HUGGINGFACE_TOKEN=

# --- Colab Pro / Google Drive bridge ----------------------------------------
# Primary path (no API keys): local folder synced by Google Drive for Desktop.
# Example (macOS): /Users/you/Google Drive/MyDrive
# The bridge uses <DRIVE_SYNC_DIR>/masld-bridge/{outbox,inbox,done}.
DRIVE_SYNC_DIR=

# Optional: service-account JSON for headless Drive API access without the
# sync client. The target Drive folder must be shared with the account email.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: ngrok authtoken for a direct Colab->laptop HTTP tunnel (free tier
# is enough). Without this, the bridge communicates exclusively via Drive.
NGROK_AUTHTOKEN=

# --- Local model inference ---------------------------------------------------
# Force cpu | mps | cuda. Default: auto-detect with an MPS warmup probe.
MASLD_DEVICE=
