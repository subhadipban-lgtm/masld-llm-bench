   "source": [
    "# v3 RECIPE (token-budgeted): v2's blind x4 liver upsample tripled long-prompt\n",
    "# tokens (~20h train). The v1 failure was FORMAT volume: multiclass/binary/reg\n",
    "# had 135 examples each (0.4%). Fix: upsample single-profile formats x16,\n",
    "# keep pairwise x1 (it already works, and dominates liver), cap drugs 10k.\n",
    "import json, os, random\n",
    "rs = random.Random(20260929)\n",
    "\n",
    "def load(p):\n",
    "    return json.load(open(p)) if os.path.exists(p) else []\n",
    "\n",
    "liver = load('/content/sft_liver.json')            # 3928: 3388 pairwise + 540 single-profile\n",
    "external = load('/content/sft_external.json')      # 5575 (mixed formats)\n",
    "fujiwara = load('/content/sft_fujiwara.json')      # 204 single-profile\n",
    "knowledge = load('/content/sft_knowledge.json')    # 2701\n",
    "dge = load('/content/sft_dge.json')                # 8088\n",
    "drugs1 = load('/content/sft_drugs.json')           # 30000\n",
    "drugs2 = load('/content/sft_drugs2.json')          # 39632\n",
    "dnam = load('/content/sft_dnam.json')              # 73\n",
    "\n",
    "# split liver by format: pairwise prompts contain two patient blocks\n",
    "def is_pairwise(ex):\n",
    "    return 'Patient A:' in ex['instruction']\n",
    "liver_single = [e for e in liver if not is_pairwise(e)]   # 540\n",
    "liver_pair = [e for e in liver if is_pairwise(e)]          # 3388\n",
    "ext_single = [e for e in external if not is_pairwise(e)]\n",
    "ext_pair = [e for e in external if is_pairwise(e)]\n",
    "\n",
    "def upsample(rows, factor):\n",
    "    if not rows or factor <= 1:\n",
    "        return list(rows)\n",
    "    out = list(rows)\n",
    "    target = len(rows) * factor\n",
    "    while len(out) < target:\n",
    "        out += rs.sample(rows, min(len(rows), target - len(out)))\n",
    "    return out[:target]\n",
    "\n",
    "# x16 the failing single-profile formats; pairwise x1 (already 0.47 at v1)\n",
    "single = (upsample(liver_single, 16) + ext_single\n",
    "          + upsample(fujiwara, 8) + upsample(dnam, 20))\n",
    "pair = liver_pair + ext_pair\n",
    "drugs = rs.sample(drugs1 + drugs2, 10000)\n",
    "know = rs.sample(knowledge + dge, 8000)\n",
    "\n",
    "mixture = single + pair + drugs + know\n",
    "rs.shuffle(mixture)\n",
    "json.dump(mixture, open('/content/sft_multitask.json', 'w'), indent=0)\n",
    "print(f'single-profile: {len(liver_single)}x16 + {len(ext_single)} + fujiwara/dnam ups = {len(single)}')\n",
    "print(f'pairwise: {len(pair)} | drugs {len(drugs)} | knowledge {len(know)}')\n",
    "print(f'FINAL MIXTURE: {len(mixture)} (single {100*len(single)/len(mixture):.0f}%, pair {100*len(pair)/len(mixture):.0f}%, drugs {100*len(drugs)/len(mixture):.0f}%, know {100*len(know)/len(mixture):.0f}%)')\n",
    "print(f'expected train time ~ 2 epochs x ~26M tokens/epoch ~ 12h (v1: 3 x 16M = 11h)')"
   ]
