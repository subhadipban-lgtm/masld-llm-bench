    "\n",
    "if not os.path.exists(f'{MERGED_17B}/config.json') or \\\n",
    "   os.path.getmtime(f'{MERGED_17B}/model.safetensors' if os.path.exists(f'{MERGED_17B}/model.safetensors') else f'{MERGED_17B}/config.json') < os.path.getmtime(os.path.join(adapter, 'adapter_model.safetensors')):\n",
