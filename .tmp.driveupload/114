    "            gen = model.generate(**enc, max_new_tokens=30, do_sample=False,\n",
    "                                 pad_token_id=tok.pad_token_id)\n",
    "        for j in range(len(batch)):\n",
    "            text = tok.decode(gen[j][enc['input_ids'].shape[1]:], skip_special_tokens=True)\n",
    "            raws.append(text.split('\\n')[0])\n",
    "        i += len(batch)\n",
    "    except torch.cuda.OutOfMemoryError:\n",
    "        torch.cuda.empty_cache()\n",
    "        if BATCH == 1: raise\n",
    "        BATCH = max(1, BATCH // 2)\n",
    "        print(f'OOM -> batch {BATCH}')\n",
    "    if i % 80 < BATCH:\n",
    "        print(f'  {i}/{len(sample)}', flush=True)\n",
    "\n",
    "runs_dir = (os.path.join(MASLD_LLM, 'results', 'frontier_runs')\n",
    "            if os.access(os.path.join(MASLD_LLM, 'results'), os.W_OK)\n",
    "            else '/content/drive/MyDrive/masld-llm-outputs/frontier_runs')\n",
    "os.makedirs(runs_dir, exist_ok=True)\n",
    "run_path = runs_dir + '/qwen3-1.7b-masld__MB-20xx.jsonl.gz'\n",
    "with gzip.open(run_path, 'wt') as f:\n",
    "    for r, raw in zip(sample, raws):\n",
    "        f.write(json.dumps(dict(task=r['task'], sample=r['sample'], answer=r['answer'],\n",
    "                                raw=raw, error=None, model_version='qwen3-1.7b-masld-v4',\n",
    "                                parsed=parse_answer(raw, r['task']))) + chr(10))\n",
    "print('archived ->', run_path)\n",
    "\n",
    "import collections\n",
    "bt = collections.defaultdict(list)\n",
    "for r, raw in zip(sample, raws):\n",
    "    bt[r['task']].append((parse_answer(raw, r['task']), r['answer']))\n",
    "print('\\n=== qwen3-1.7b-masld v4 ===')\n",
    "for t, pairs in sorted(bt.items()):\n",
    "    valid = sum(1 for p, g in pairs if p is not None)\n",
    "    n = len(pairs)\n",
    "    if t in ('MB-2001', 'MB-2002', 'MB-2003'):\n",
    "        acc = sum(1 for p, g in pairs if p == g) / n\n",
