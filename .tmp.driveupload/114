    "dnam = load('/content/sft_dnam.json')\n",
    "\n",
    "def is_pairwise(ex):\n",
    "    return 'Patient A:' in ex['instruction']\n",
    "liver_single = [e for e in liver if not is_pairwise(e)]\n",
    "liver_pair = [e for e in liver if is_pairwise(e)]\n",
    "ext_single = [e for e in external if not is_pairwise(e)]\n",
    "ext_pair = [e for e in external if is_pairwise(e)]\n",
    "\n",
    "# --- v4: class-aware upsampling of liver singles ---\n",
    "# multiclass answers: balance F0..F4 to ~equal (train dist F0:32 F1:50 F2:23 F3:23 F4:7)\n",
    "STAGE_W = {'F0': 2, 'F1': 1, 'F2': 2, 'F3': 2, 'F4': 7}\n",
    "def task_kind(ex):\n",
    "    q = ex['instruction']\n",
    "    if 'Assign the fibrosis stage' in q or 'Which fibrosis stage' in q: return 'multi'\n",
    "    if 'advanced fibrosis' in q: return 'binary'\n",
    "    if 'NAFLD Activity Score' in q or 'exact NAS' in q: return 'nas'\n",
    "    if 'age in years' in q or 'chronological age' in q: return 'age'\n",
    "    return 'fibreg'\n",
    "\n",
    "def upsample_weighted(rows, base_factor, weight_fn):\n",
    "    out = []\n",
    "    for e in rows:\n",
    "        w = weight_fn(e)\n",
    "        n_copies = max(1, int(base_factor * w))\n",
    "        out += [e] * n_copies\n",
    "    return out\n",
    "\n",
    "def liver_weight(ex):\n",
    "    k = task_kind(ex)\n",
    "    if k == 'multi':\n",
    "        ans = str(ex['output']).strip()\n",
    "        return STAGE_W.get(ans, 1)\n",
    "    if k == 'binary':\n",
    "        return 3 if str(ex['output']).strip().lower() == 'yes' else 1\n",
    "    if k == 'nas':\n",
    "        return 3\n",
    "    return 1\n",
    "\n",
    "liver_single_up = upsample_weighted(liver_single, 8, liver_weight)\n",
    "fujiwara_up = list(fujiwara) * 8\n",
    "dnam_up = list(dnam) * 20 if dnam else []\n",
    "\n",
    "single = liver_single_up + ext_single + fujiwara_up + dnam_up\n",
    "pair = liver_pair + ext_pair\n",
    "drugs = rs.sample(drugs1 + drugs2, 10000)\n",
    "know = rs.sample(knowledge + dge, 8000)\n",
    "\n",
    "mixture = single + pair + drugs + know\n",
    "rs.shuffle(mixture)\n",
    "json.dump(mixture, open('/content/sft_multitask_17b.json', 'w'), indent=0)\n",
    "print(f'liver singles: {len(liver_single)} -> {len(liver_single_up)} (class-balanced x8 base)')\n",
    "print(f'single pool {len(single)} | pair {len(pair)} | drugs {len(drugs)} | know {len(know)}')\n",
    "print(f'FINAL v4 MIXTURE: {len(mixture)}')\n",
    "from collections import Counter\n",
    "mc = [str(e['output']) for e in liver_single_up if task_kind(e) == 'multi']\n",
