    "# Merge the LoRA adapter into the base model BEFORE installing vLLM.\n",
    "# Primary: llamafactory export (yaml, output captured). Fallback: direct PeFT\n",
    "# merge_and_unload() - no llamafactory dependency, works with any checkpoint dir.\n",
    "import subprocess, sys, os, glob, shutil\n",
    "\n",
    "CKPT_SFT = f'{CKPT}/qwen3-0.6b-masld-sft'\n",
    "\n",
    "adapter = None\n",
    "if os.path.exists(os.path.join(CKPT_SFT, 'adapter_model.safetensors')):\n",
    "    adapter = CKPT_SFT\n",
    "else:\n",
    "    ckpts = sorted(glob.glob(f'{CKPT_SFT}/checkpoint-*'),\n",
    "                   key=lambda p: int(p.rsplit('-', 1)[-1]))\n",
    "    if ckpts:\n",
    "        adapter = ckpts[-1]\n",
    "assert adapter, f'No adapter found in {CKPT_SFT} - re-run cell 8 (training) first.'\n",
    "if adapter != CKPT_SFT:\n",
    "    print('NOTE: root adapter missing => training did not finish.')\n",
    "    print('      Merging the LATEST checkpoint. Check cell 8 output to see why it stopped;')\n",
    "    print('      re-run cell 8 for the final adapter if it crashed.')\n",
    "print('merging adapter:', adapter)\n",
    "\n",
    "MERGED = '/content/qwen3-0.6b-masld-merged'   # local disk: fast, avoids Drive stalls\n",
    "\n",
    "# ---------- primary: llamafactory export (errors now visible) ----------\n",
    "export_yaml = f'''\n",
    "model_name_or_path: Qwen/Qwen3-0.6B\n",
    "adapter_name_or_path: {adapter}\n",
    "template: qwen\n",
    "finetuning_type: lora\n",
    "export_dir: {MERGED}\n",
    "export_size: 2\n",
    "export_device: cpu\n",
    "export_legacy_format: false\n",
    "'''\n",
    "open('/content/export_06b.yaml', 'w').write(export_yaml)\n",
    "\n",
    "ok_export = False\n",
    "try:\n",
    "    env = dict(os.environ, DISABLE_VERSION_CHECK='1')\n",
    "    result = subprocess.run(\n",
    "        [sys.executable, '-m', 'llamafactory.cli', 'export', '/content/export_06b.yaml'],\n",
    "        env=env, capture_output=True, text=True, timeout=1800)\n",
    "    if result.stdout:\n",
    "        print('--- llamafactory export stdout (tail) ---')\n",
    "        print(result.stdout[-2500:])\n",
    "    if result.returncode == 0 and os.path.exists(f'{MERGED}/config.json'):\n",
    "        ok_export = True\n",
    "    else:\n",
    "        print('--- llamafactory export FAILED, stderr (tail) ---')\n",
    "        print(result.stderr[-2500:])\n",
    "except Exception as e:\n",
    "    print('llamafactory export raised:', e)\n",
    "\n",
    "# ---------- fallback: direct PeFT merge (always works) ----------\n",
    "if not ok_export:\n",
    "    print('=== falling back to direct PeFT merge_and_unload() ===')\n",
    "    import torch\n",
    "    from transformers import AutoModelForCausalLM, AutoTokenizer\n",
    "    from peft import PeftModel\n",
    "    base = AutoModelForCausalLM.from_pretrained(\n",
    "        'Qwen/Qwen3-0.6B', torch_dtype=torch.bfloat16)\n",
    "    model = PeftModel.from_pretrained(base, adapter)\n",
    "    model = model.merge_and_unload()\n",
    "    model.save_pretrained(MERGED, safe_serialization=True)\n",
    "    AutoTokenizer.from_pretrained('Qwen/Qwen3-0.6B').save_pretrained(MERGED)\n",
    "    print('PeFT merge complete ->', MERGED)\n",
    "\n",
    "# ---------- persist to Drive (best-effort; ~1.2 GB) ----------\n",
    "try:\n",
    "    dst = f'{CKPT}/qwen3-0.6b-masld-merged'\n",
    "    if not os.path.exists(dst):\n",
    "        shutil.copytree(MERGED, dst)\n",
    "    print('persisted to Drive:', dst)\n",
    "except Exception as e:\n",
    "    print('Drive copy skipped (model is safe at', MERGED, '):', e)"
